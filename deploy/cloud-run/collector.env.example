# Non-secret deployment settings. Copy to collector.env and edit before use.
GCP_PROJECT=YOUR_PROJECT_ID
GCP_REGION=us-central1
COLLECTOR_SERVICE=hn-otel-collector
COLLECTOR_SERVICE_ACCOUNT=hn-otel-collector@YOUR_PROJECT_ID.iam.gserviceaccount.com
COLLECTOR_IMAGE=docker.io/clickhouse/clickstack-otel-collector:2.40.0
CLICKHOUSE_ENDPOINT=https://YOUR_CLICKSTACK_HOST:8443
CLICKHOUSE_USER=hn_otel_ingest
CLICKHOUSE_DATABASE=otel
# Secret Manager resource names and numeric versions; NEVER put values here.
CLICKHOUSE_PASSWORD_SECRET=hn-clickstack-password:1
OTLP_TOKEN_SECRET=hn-otlp-token:1
