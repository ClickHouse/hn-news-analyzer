{
  "name": "open-house-otel-collector-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Pre-instrumented ClickStack OpenTelemetry demo with optional AI chat. TypeScript HackerNews analyzer querying the public ClickHouse demo cluster. Express backend auto-instrumented via opentelemetry-instrument (@hyperdx/node-opentelemetry); React frontend uses @hyperdx/browser for session replay and trace propagation. Chat turns are traced to Langfuse with an isolated tracer provider so they do not replace the ClickStack SDK.",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:chat": "npm run build:server && node --test scripts/test-chat.cjs",
    "test:vercel": "npm run build:server && node --test scripts/test-vercel.cjs",
    "test:telemetry": "npm run build:server && node --test scripts/test-chat-telemetry.cjs"
  },
  "dependencies": {
    "@clickhouse/click-ui": "^0.6.0",
    "@clickhouse/client": "^1.18.5",
    "@hyperdx/browser": "^0.25.1",
    "@hyperdx/node-opentelemetry": "^0.11.0",
    "@langfuse/openai": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "dayjs": "^1.11.19",
    "express": "^5.2.1",
    "openai": "^7.32.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "recharts": "^3.8.1",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": ">=22"
  }
}
