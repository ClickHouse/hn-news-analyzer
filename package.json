{
  "name": "open-house-otel-collector-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Pre-instrumented ClickStack OpenTelemetry demo. TypeScript HackerNews analyzer querying the public ClickHouse demo cluster. Express backend auto-instrumented via opentelemetry-instrument (@hyperdx/node-opentelemetry); React frontend uses @hyperdx/browser for session replay and trace propagation.",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@clickhouse/click-ui": "^0.6.0",
    "@clickhouse/client": "^1.18.5",
    "@hyperdx/browser": "^0.25.1",
    "@hyperdx/node-opentelemetry": "^0.11.0",
    "dayjs": "^1.11.19",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "recharts": "^3.8.1",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": ">=18"
  }
}
